{
  "name": "goa-startup-festival-2026",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check:governed-styles": "tsx scripts/check-governed-styles.ts",
    "clean": "rm -rf .next",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:component": "vitest run --config vitest.config.ts --project component",
    "test:a11y": "vitest run --config vitest.config.ts --project accessibility",
    "test:property": "vitest run --config vitest.config.ts --project property",
    "test:ssr": "vitest run --config vitest.config.ts --project ssr",
    "test:browser": "playwright test",
    "test:browser:list": "playwright test --list",
    "test:all": "npm run test && npm run test:browser",
    "validate": "npx tsc --noEmit && vitest run --config vitest.config.ts && next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:auth:migrate": "npx auth@latest migrate"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.25",
    "@react-email/components": "^1.0.12",
    "@vercel/blob": "^2.9.0",
    "autoprefixer": "^10.4.21",
    "better-auth": "^1.7.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.5.29",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.1",
    "postcss": "^8.5.33",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "resend": "^6.18.1",
    "sanitize-html": "^2.18.2",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest-axe": "3.5.9",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.1",
    "eslint-config-next": "^16.4.6",
    "fast-check": "4.9.0",
    "jest-axe": "11.0.0",
    "jsdom": "29.1.1",
    "tailwindcss": "4.1.11",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "$postcss",
    "zod": "$zod"
  }
}
