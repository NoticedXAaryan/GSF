# ────────────────────────────────────────────────────────────
# Goa Startup Festival 2026 — Environment Configuration
# ────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Database ──
DATABASE_URL=postgresql://gsf_user:your_password@localhost:5432/gsf2026

# ── Better Auth ──
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here-generate-with-openssl
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth ──
# Create at: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google (dev)
#               https://your-domain.com/api/auth/callback/google (prod)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── SMTP (Club Email) ──
# Used by Better Auth for sending verification/notification emails.
# Configure your club email SMTP settings here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=club@goa.paruluniversity.ac.in
SMTP_PASS=your-app-password

# ── Application ──
NODE_ENV=development
