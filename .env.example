# ────────────────────────────────────────────────────────────
# Goa Startup Festival 2026 — Environment Configuration
# ────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Database ──
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ── Better Auth ──
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth ──
# Create at: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google (dev)
#               https://your-domain.com/api/auth/callback/google (prod)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── SMTP (Email Sending) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=Goa Startup Festival 2026

# ── Admin Setup ──
# One-time token for promoting a user to Admin via POST /api/admin/setup
# Generate with: openssl rand -hex 32
# Remove or leave empty after initial admin is created.
ADMIN_SETUP_TOKEN=your-admin-setup-token

# ── Application ──
NODE_ENV=development

# ── Optional integrations ──
# Vercel Blob token used by POST /api/upload. Leave empty to disable uploads.
BLOB_READ_WRITE_TOKEN=

# Resend API key. Used when an admin accepts an application.
# Leave empty to skip that email; in-app notifications still save.
RESEND_API_KEY=

# SMTP From address. Defaults to SMTP_USER when empty.
FROM_EMAIL=

# Restrict Google sign-in to one Workspace domain (for example goa.paruluniversity.ac.in).
# Leave empty to allow any Google account.
GOOGLE_OAUTH_RESTRICT_DOMAIN=
